{
  "name": "rental-management-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "test": "npm run test --workspace=server",
    "lint": "concurrently \"npm run lint --workspace=server\" \"npm run lint --workspace=client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
